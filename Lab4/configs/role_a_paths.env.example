# Copy this file to role_a_paths.env and modify it according to your machine.

# Root directory of local Lab4 project
export LAB4_DIR="$HOME/Desktop/OSH2026_Lab4_Local/Lab4"

# llama.cpp source directory
export LLAMA_CPP_DIR="$LAB4_DIR/llama.cpp"

# llama.cpp executable paths
export LLAMA_BUILD_DIR="$LLAMA_CPP_DIR/build/bin"
export LLAMA_CLI="$LLAMA_BUILD_DIR/llama-cli"
export LLAMA_BENCH="$LLAMA_BUILD_DIR/llama-bench"

# Model path. Replace this with the real GGUF file.
export MODEL_PATH="$LAB4_DIR/models/your-model.gguf"

# Default inference parameters
export N_PREDICT=128
export THREADS=4
export CTX_SIZE=2048
export BATCH_SIZE=256
